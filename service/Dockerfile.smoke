# Isolated-smoke-only Dockerfile for the sc-component-backup service.
# The production Dockerfile targets AWS Lambda; this one targets a
# normal Linux container so docker-compose can run it. Also carries
# mongodump/mongorestore so the mongodb driver's shell-outs work.
#
# NOT published. Lives next to Dockerfile for the smoke rig only.

ARG GO_VERSION=1.27

FROM golang:${GO_VERSION}-alpine AS builder
WORKDIR /src
# Copy the api/ sibling in too — the service module has an indirect
# via the repo's go.work on the dev machine, but the container build
# only needs the service module itself.
COPY service/go.mod service/go.sum ./service/
WORKDIR /src/service
# service/go.mod routes github.com/FerretDB/FerretDB to the PRIVATE fork
# github.com/simple-container-com/go-embedb, so even this local smoke
# build needs a read credential — the replace is resolved while loading
# the module graph, before any build tag or env var is consulted.
#
# Same buildx secret mount as the production Dockerfile, for the same
# reason (never a layer, never a build-arg). dev/docker-compose.yml
# declares the secret; dev/smoke.sh checks the plaintext is present and
# tells you to `sc secrets reveal --force` if it is not.
ENV GOPRIVATE=github.com/simple-container-com/*
RUN apk add --no-cache git openssh-client \
    && mkdir -p /root/.ssh \
    && ssh-keyscan -t rsa,ecdsa,ed25519 github.com >> /root/.ssh/known_hosts 2>/dev/null \
    && git config --global url."git@github.com:".insteadOf "https://github.com/"
RUN --mount=type=secret,id=go_embedb_key \
    GIT_SSH_COMMAND="ssh -i /run/secrets/go_embedb_key -o IdentitiesOnly=yes" \
      go mod download
WORKDIR /src
COPY service/ ./service/
WORKDIR /src/service
ARG VERSION=smoke
ARG COMMIT=smoke
ARG REVISION=smoke
RUN CGO_ENABLED=0 go build \
    -trimpath -buildvcs=false \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.revision=${REVISION}" \
    -o /out/backup ./cmd/backup

FROM alpine:3.20
RUN apk add --no-cache ca-certificates mongodb-tools wget
COPY --from=builder /out/backup /usr/local/bin/backup
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/backup"]
